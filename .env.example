# === Обязательно ===
DISCORD_TOKEN=your_bot_token_here

# === Гильдии для slash-команд (рекомендуется, обход лимита 100 global) ===
# Один или несколько ID через запятую
GUILD_IDS=YOUR_GUILD_ID_HERE
# Альтернативные имена:
# GUILD_ID=...
# DISCORD_GUILD_IDS=...
# DISCORD_GUILD_ID=...

# === Коги ===
# LITE_MODE=1 (по умолчанию) — отключает тяжёлые коги
# LITE_MODE=0 — загрузить все
LITE_MODE=1
# Явно включить коги (через запятую, имена без .py):
# ENABLED_COGS=games,media,grow_tree,market
# Явно выключить:
# DISABLED_COGS=webpanel,combat

# Отключить отдельные slash-команды:
# DISABLED_APP_COMMANDS=eco_select,audit_risk

# === Голос / музыка ===
# OPUS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libopus.so.0

# === Экономика / VIP ===
# VIP_CARD_ROLE_ID=123456789012345678
# VIP_CARD_ROLE_ID_<GUILD_ID>=...

# === ИИ-чат ===
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# === Прочее ===
# LOG_LEVEL=INFO
